# QUE Agent — staging configuration
# Same shape as `.env.example`. Staging = production guards enabled, but
# safer defaults for a pre-prod environment (tools off until Quizzer
# staging's internal URL + service key are confirmed working).

# --- App ---
APP_ENV=staging
APP_NAME=QUE-Agent
APP_VERSION=0.1.0
CORS_ALLOW_ORIGINS=https://staging.quizzer.example

# --- Service auth ---
QUE_SERVICE_KEY=replace-with-a-generated-strong-secret
ALLOW_INSECURE_LOCAL_NO_AUTH=false

# --- Que access JWT (must match Quizzer staging's QUE_JWT_SECRET) ---
QUE_JWT_SECRET=replace-with-the-shared-staging-que-jwt-secret-32c
QUE_JWT_ALGORITHM=HS256
QUE_JWT_AUDIENCE=que-agent
QUE_JWT_ISSUER=quizzer

# --- LLM ---
LLM_API_KEY=replace-with-a-real-key
LLM_BASE_URL=https://openrouter.ai/api/v1
# Chat models live here only — not in Python. LLM_MODEL is preferred on
# agent / multi_step turns if it also appears in LLM_MODELS.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_MODELS=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0.35
LLM_GATEWAY_RR=true
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_MS=200
LLM_RETRY_CAP_MS=2000

# Insight + write tools — flip on once Quizzer staging internal API is confirmed.
QUE_TOOLS_ENABLED=false
QUIZZER_INTERNAL_BASE_URL=https://quizzer-staging-internal.example
QUE_TOOL_MAX_CALLS=2
QUE_TOOL_TIMEOUT_SECONDS=3
QUE_TOOL_CIRCUIT_FAILURES=5
QUE_TOOL_CIRCUIT_TTL_SECONDS=30
QUE_AGENT_MAX_STEPS=3
QUE_AGENT_MAX_EXECUTION_MS=8000
QUE_AGENT_MAX_TOOL_CHARS=12000

QUE_GUARDRAILS_ENABLED=true

QUE_EVAL_ONLINE_SAMPLE=false
QUE_EVAL_ONLINE_RATE=0.05
QUE_EVAL_ONLINE_PATH=data/eval_online.jsonl

QUE_OBS_JSONL=data/obs_staging.jsonl
QUE_OBS_RING_SIZE=512
QUE_BUDGET_LLM_CALLS_PER_TURN=3
QUE_BUDGET_TOKENS_PER_TURN=16000
QUE_BUDGET_USD_PER_USER_HOUR=0.50
QUE_ALERT_ERROR_RATE=0.35
QUE_ALERT_USD_PER_MINUTE=0.25
QUE_ALERT_COOLDOWN_SECONDS=60

QUE_LLM_CIRCUIT_FAILURES=5
QUE_LLM_CIRCUIT_TTL_SECONDS=30

# Rate limiting — same lenient defaults as prod.
QUE_RATE_LIMIT_ENABLED=true
QUE_RATE_LIMIT_PER_MINUTE=60
QUE_RATE_LIMIT_BURST=20
QUE_BUDGET_WRITE_ACTIONS_PER_HOUR=20

QUE_CACHE_ENABLED=true
QUE_CACHE_MAX_ENTRIES=512
QUE_CACHE_INTENT_TTL_SECONDS=3600
QUE_CACHE_LLM_TTL_SECONDS=900
QUE_CACHE_RETRIEVAL_TTL_SECONDS=1800
QUE_CACHE_VARIANT_TTL_SECONDS=1800

QUE_MEMORY_ENABLED=true
QUE_MEMORY_MAX_TURNS=20

QUE_RAG_ENABLED=true
QUE_CHROMA_PATH=/app/data/chroma
QUE_EMBEDDING_MODEL=openai/text-embedding-3-small
QUE_RAG_TOP_K=6
QUE_RAG_MIN_SCORE=0.28
QUE_RAG_FALLBACK_KEYWORD=true
QUE_RAG_HYBRID=true
QUE_RAG_CANDIDATE_K=20
QUE_RAG_RRF_K=60

# --- Server ---
HOST=0.0.0.0
PORT=8100
LOG_LEVEL=INFO
