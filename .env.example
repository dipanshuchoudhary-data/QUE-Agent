# QUE Agent — local / deploy configuration
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- App ---
APP_ENV=local
APP_NAME=QUE-Agent
APP_VERSION=0.1.0
# Browser calls QUE directly — list Quizzer frontend origin(s).
# Example: http://localhost:3000,https://app.quizzer.example
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Service auth (server → QUE only; never ship to the browser) ---
# Future QUE→Quizzer tool calls / ops. Optional for browser chat.
QUE_SERVICE_KEY=change-me-to-a-long-random-secret

# When true (local only), skip auth checks so you can hit /docs.
# Production startup refuses to start if this is true.
ALLOW_INSECURE_LOCAL_NO_AUTH=false

# --- Que access JWT (browser → QUE) ---
# MUST match Quizzer Backend QUE_JWT_SECRET. Quizzer mints; QUE verifies.
QUE_JWT_SECRET=change-me-to-a-long-shared-que-jwt-secret-32chars
QUE_JWT_ALGORITHM=HS256
QUE_JWT_AUDIENCE=que-agent
QUE_JWT_ISSUER=quizzer

# --- LLM (OpenAI-compatible / OpenRouter) ---
# One or more keys. Numbered keys are round-robined with LLM_API_KEY.
LLM_API_KEY=
LLM_API_KEY_1=
LLM_API_KEY_2=
LLM_API_KEY_3=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Chat models live here only — not in Python. LLM_MODEL is preferred on
# agent / multi_step turns if it also appears in LLM_MODELS.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_MODELS=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0.35
LLM_GATEWAY_RR=true
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_MS=200
LLM_RETRY_CAP_MS=2000

# Phase 4 insight tools (QUE → Quizzer). Off until Quizzer internal URL is set.
QUE_TOOLS_ENABLED=false
QUIZZER_INTERNAL_BASE_URL=http://127.0.0.1:8000
QUE_TOOL_MAX_CALLS=2
QUE_TOOL_TIMEOUT_SECONDS=3
QUE_TOOL_CIRCUIT_FAILURES=5
QUE_TOOL_CIRCUIT_TTL_SECONDS=30
# Phase 7 agent loop (only for multi-intent live asks)
QUE_AGENT_MAX_STEPS=3
QUE_AGENT_MAX_EXECUTION_MS=8000
QUE_AGENT_MAX_TOOL_CHARS=12000

# Phase 10 guardrails (on top of Phase 5 policy; default on)
QUE_GUARDRAILS_ENABLED=true

# Phase 11 sampled online eval (hashed ids only; off by default)
QUE_EVAL_ONLINE_SAMPLE=false
QUE_EVAL_ONLINE_RATE=0.05
QUE_EVAL_ONLINE_PATH=data/eval_online.jsonl

# Phase 12 observability + cost (in-process; not Datadog)
QUE_OBS_JSONL=
QUE_OBS_RING_SIZE=512
QUE_BUDGET_LLM_CALLS_PER_TURN=3
QUE_BUDGET_TOKENS_PER_TURN=16000
QUE_BUDGET_USD_PER_USER_HOUR=0.50
QUE_ALERT_ERROR_RATE=0.35
QUE_ALERT_USD_PER_MINUTE=0.25
QUE_ALERT_COOLDOWN_SECONDS=60

# Phase 13 LLM provider circuit (tools already have QUE_TOOL_CIRCUIT_*)
QUE_LLM_CIRCUIT_FAILURES=5
QUE_LLM_CIRCUIT_TTL_SECONDS=30

# Phase 14 — lenient in-process rate limit on /v1/chat[/stream] (per user/IP)
QUE_RATE_LIMIT_ENABLED=true
QUE_RATE_LIMIT_PER_MINUTE=60
QUE_RATE_LIMIT_BURST=20

# Phase 14 — confirmed write tools (publish/notify/delete). Independent
# per-user cap on top of the general tool/LLM budgets above.
QUE_BUDGET_WRITE_ACTIONS_PER_HOUR=20

# --- QUE-local cache (in-process; NOT Quizzer Redis) ---
QUE_CACHE_ENABLED=true
QUE_CACHE_MAX_ENTRIES=512
# FAQ intent resolution
QUE_CACHE_INTENT_TTL_SECONDS=3600
# Repeated LLM answers for the same conversation turn fingerprint
QUE_CACHE_LLM_TTL_SECONDS=900
# Product RAG chunk selection (slow-changing guides)
QUE_CACHE_RETRIEVAL_TTL_SECONDS=1800
# Avoid repeating the same canned variant back-to-back in a conversation
QUE_CACHE_VARIANT_TTL_SECONDS=1800

# Short-term conversation memory (LangGraph MemorySaver — per worker process)
QUE_MEMORY_ENABLED=true
QUE_MEMORY_MAX_TURNS=20

# --- Phase 2 RAG (QUE-owned Chroma; NOT Quizzer DB) ---
# Build index: uv run python -m app.knowledge --force
QUE_RAG_ENABLED=true
QUE_CHROMA_PATH=data/chroma
# Same host as LLM_BASE_URL (OpenRouter / OpenAI-compatible embeddings)
QUE_EMBEDDING_MODEL=openai/text-embedding-3-small
QUE_RAG_TOP_K=6
# Cosine similarity floor; below this → honest no-answer (CORE only)
QUE_RAG_MIN_SCORE=0.28
# If index missing/corrupt, fall back to keyword manifest matching
QUE_RAG_FALLBACK_KEYWORD=true
# Phase 6 hybrid: dense + BM25 RRF (needs bm25_corpus.json from ingest)
QUE_RAG_HYBRID=true
QUE_RAG_CANDIDATE_K=20
QUE_RAG_RRF_K=60

# --- Server ---
HOST=0.0.0.0
PORT=8100
LOG_LEVEL=INFO
